# ============================================================================
# Repo2Cloud Configuration (.env.example)
# ============================================================================

# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# Deployment Execution Mode
# Set AWS_DRY_RUN=false when ready to provision real AWS resources.
# When AWS_DRY_RUN=true (or when AWS_ACCESS_KEY_ID is not set), Repo2Cloud
# still performs real GitHub repository analysis and isolated builds, while
# simulating AWS S3/CloudFront/ECS/Lambda/Amplify/Route53 API calls safely.
AWS_DRY_RUN=true

# AWS Credentials & Region (Use least-privilege IAM role for deployment worker)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Phase 1: Static Sites (S3 + CloudFront)
S3_DEPLOYMENT_BUCKET_PREFIX=repo2cloud-static

# Phase 2: Shared Domain Manager (Route 53 + ACM)
# Comma-separated server-controlled list of domains with Route 53 Hosted Zones:
# Format: domainName:hostedZoneId[:wildcardAcmCertArnInUsEast1]
CONFIGURED_DOMAINS=maas-fam.com:Z08163272O28TLSJ7THDI

# Phase 4: ECS Fargate Configuration
ECS_CLUSTER_NAME=repo2cloud-cluster
ECS_VPC_ID=
ECS_PRIVATE_SUBNET_IDS=
ECS_ALB_ARN=
ECS_ALB_LISTENER_ARN=
ECS_ALB_DNS_NAME=
ECS_EXECUTION_ROLE_ARN=
ECS_TASK_ROLE_ARN=

# Phase 5: Lambda + API Gateway Configuration
LAMBDA_EXECUTION_ROLE_ARN=

# Phase 6: AWS Amplify Configuration
GITHUB_ACCESS_TOKEN=

# Phase 7: Security, Isolation & Quotas
# Isolated build workspace directory (outside Express server source tree)
ISOLATED_BUILD_ROOT=/tmp/repo2cloud-isolated-builds
USE_DOCKER_ISOLATION=false
MAX_BUILD_DURATION_MS=180000
MAX_DEPLOYMENT_DURATION_MS=600000
MAX_CONCURRENT_DEPLOYMENTS=5
RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=30
RATE_LIMIT_WINDOW_MS=60000

# Optional: DynamoDB table for persistent state (falls back to local JSON disk store at backend/data/deployments.json)
DYNAMODB_TABLE_NAME=
